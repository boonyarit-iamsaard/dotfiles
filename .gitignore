# Fonts are never committed. Consolas is proprietary and its Nerd Font patch
# (windows/scripts/patch-consolas-nerd-font) is a derivative work; this repo is public.
*.ttf
*.otf
*.ttc
*.woff
*.woff2

# Repository-local formatting dependencies.
/node_modules/

# Local agent scratch space (issues, specs). Opt in to tracking with git add -f.
/.scratch/

# Local reconciliation state for macos/scripts/update-skills.
macos/.skill-sync/

# Test bytecode and runtime state are generated locally.
__pycache__/
*.log

# Tool-written runtime state.
macos/.config/lazygit/state.yml
# superfile writes its bundled themes here; only the one we made is tracked.
macos/.config/superfile/theme/*
!macos/.config/superfile/theme/default-dark-modern.toml
