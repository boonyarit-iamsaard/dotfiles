{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }} - pwsh",
  "palette": {
    "seg_badge": "#0078d4",
    "text_badge": "#ffffff",
    "seg_dir": "#4b4132",
    "text_dir": "#e2c08d",
    "seg_git": "#2d3d30",
    "text_git": "#81b88b",
    "seg_lang": "#1b3043",
    "text_lang": "#4daafc",
    "seg_time": "#222222",
    "text_time": "#9d9d9d",
    "green": "#81b88b",
    "red": "#f85149",
    "muted": "#9d9d9d"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "background": "p:seg_badge",
          "foreground": "p:text_badge",
          "template": " {{ .Icon }}",
          "options": {
            "windows": "󰍲",
            "macos": "󰀵",
            "linux": "󰌽"
          }
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_badge",
          "foreground": "p:text_badge",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_dir",
          "foreground": "p:text_dir",
          "template": " {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "…",
            "home_icon": "~",
            "mapped_locations": {
              "~/Documents": "󰂙 Documents",
              "~/Downloads": " Downloads",
              "~/Music": "󰍚 Music",
              "~/Pictures": " Pictures",
              "~/Developer": "󱂋 Developer"
            }
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_git",
          "foreground": "p:text_git",
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "options": {
            "branch_icon": " ",
            "branch_ahead_icon": "⇡",
            "branch_behind_icon": "⇣",
            "branch_identical_icon": "≡"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_lang",
          "foreground": "p:text_lang",
          "template": "  {{ .Full }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_lang",
          "foreground": "p:text_lang",
          "template": "  {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_lang",
          "foreground": "p:text_lang",
          "template": "  {{ .Full }} "
        },
        {
          "type": "java",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_lang",
          "foreground": "p:text_lang",
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_lang",
          "foreground": "p:text_lang",
          "template": "  {{ .Full }} "
        },
        {
          "type": "php",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_lang",
          "foreground": "p:text_lang",
          "template": "  {{ .Full }} "
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_lang",
          "foreground": "p:text_lang",
          "template": "  {{ .Full }} "
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:seg_time",
          "foreground": "p:text_time",
          "template": "  {{ .CurrentDate | date \"15:04\" }} ",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hidden",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:muted",
          "template": "took {{ .FormattedMs }}",
          "options": {
            "threshold": 2000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "󰄛 ❯ "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
    "template": "󰄛 ❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "template": "∙∙ "
  }
}
