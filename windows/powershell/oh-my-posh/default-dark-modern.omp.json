{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }} - pwsh",
  "palette": {
    "fg": "#cccccc",
    "gray": "#6e7681",
    "red": "#f85149",
    "green": "#2ea043",
    "yellow": "#D7BA7D",
    "blue": "#569CD6",
    "magenta": "#C586C0",
    "cyan": "#4FC1FF",
    "lavender": "#afafff"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:cyan",
          "template": "<b>{{ .Path }}</b> ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:magenta",
          "template": "on <b>{{ .HEAD }}</b> {{ if or .Working.Changed .Staging.Changed (gt .StashCount 0) (gt .Ahead 0) (gt .Behind 0) }}<p:red><b>[{{ if gt (add .Working.Unmerged .Staging.Unmerged) 0 }}={{ end }}{{ if gt .StashCount 0 }}${{ end }}{{ if gt (add .Working.Deleted .Staging.Deleted) 0 }}✘{{ end }}{{ if gt .Working.Modified 0 }}!{{ end }}{{ if .Staging.Changed }}+{{ end }}{{ if gt .Working.Untracked 0 }}?{{ end }}{{ if and (gt .Ahead 0) (gt .Behind 0) }}⇕{{ else if gt .Ahead 0 }}⇡{{ else if gt .Behind 0 }}⇣{{ end }}]</b></> {{ end }}",
          "options": {
            "branch_icon": " "
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": "via <b> v{{ .Full }}</b> "
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:cyan",
          "template": "via <b> v{{ .Full }}</b> "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:red",
          "template": "via <b>󱘗 v{{ .Full }}</b> "
        },
        {
          "type": "java",
          "style": "plain",
          "foreground": "p:red",
          "template": "via  v{{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "via <b> v{{ .Full }}{{ if .Venv }} ({{ .Venv }}){{ end }}</b> "
        },
        {
          "type": "php",
          "style": "plain",
          "foreground": "p:lavender",
          "template": "via <b> v{{ .Full }}</b> "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "p:blue",
          "template": "via <b>󰪮 v{{ .Full }}</b> "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "took <b>{{ .FormattedMs }}</b> ",
          "options": {
            "threshold": 2000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "<b>❯</b> "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
    "template": "<b>❯</b> "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:gray",
    "template": "∙ "
  }
}
