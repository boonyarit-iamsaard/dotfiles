Set-StrictMode -Version Latest

$script:DefaultTheme = 'catppuccin-macchiato'
$script:GeneratedHeader = '# Generated by windows/scripts/set-theme.ps1 from windows/config/lazydocker/config.yml; edits are overwritten.'

# Each tool's theme file, relative to the checkout root, by theme name.
$script:ThemeFiles = [ordered]@{
    'Oh My Posh' = 'windows/powershell/oh-my-posh/{0}.omp.json'
    'LazyGit' = 'shared/themes/lazygit/{0}.yml'
    'LazyDocker' = 'shared/themes/lazydocker/{0}.yml'
    'btop' = 'shared/themes/btop/{0}.theme'
    'Windows Terminal' = 'windows/config/windows-terminal/{0}.json'
}

function Get-ThemeStatePath { Join-Path $env:LOCALAPPDATA 'dotfiles\theme' }
function Get-BtopConfigPath { Join-Path $env:USERPROFILE 'scoop\apps\btop\current\btop.conf' }
function Get-LazyDockerConfigPath { Join-Path $env:APPDATA 'lazydocker\config.yml' }
function Get-TerminalSettingsPath { Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json' }

function Get-ThemeFile {
    param([string] $CheckoutRoot, [string] $Name, [string] $Tool)
    Join-Path $CheckoutRoot ($script:ThemeFiles[$Tool] -f $Name)
}

function Get-ThemeCatalog {
    <# Every theme any tool has a file for, with the tools it is missing. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)] [string] $CheckoutRoot)

    $names = foreach ($pattern in $script:ThemeFiles.Values) {
        $folder = Join-Path $CheckoutRoot (Split-Path -Parent $pattern)
        $suffix = (Split-Path -Leaf $pattern) -replace '^\{0\}', ''
        Get-ChildItem -LiteralPath $folder -File -Filter "*$suffix" |
            ForEach-Object { $_.Name.Substring(0, $_.Name.Length - $suffix.Length) }
    }

    foreach ($name in $names | Sort-Object -Unique) {
        [pscustomobject]@{
            Name = $name
            Missing = @($script:ThemeFiles.Keys | Where-Object { -not (Test-Path -LiteralPath (Get-ThemeFile $CheckoutRoot $name $_) -PathType Leaf) })
        }
    }
}

function Get-DefaultTheme { $script:DefaultTheme }

function Get-ActiveTheme {
    <# The saved theme name, or the default theme when none is saved. #>
    [CmdletBinding()]
    param()

    $statePath = Get-ThemeStatePath
    if (-not (Test-Path -LiteralPath $statePath -PathType Leaf)) {
        return $script:DefaultTheme
    }
    $name = [IO.File]::ReadAllText($statePath).Trim()
    if ($name -notmatch '^[a-z0-9-]+$') {
        throw "The saved theme in $statePath is not a theme name: '$name'. Run set-theme <name>."
    }
    $name
}

function Get-TerminalSchemeName {
    param([string] $CheckoutRoot, [string] $Name)
    $fragment = Get-Content -Raw -LiteralPath (Get-ThemeFile $CheckoutRoot $Name 'Windows Terminal') | ConvertFrom-Json
    @($fragment.schemes)[0].name
}

function Get-LazyDockerConfig {
    param([string] $CheckoutRoot, [string] $Name)

    $base = [IO.File]::ReadAllText((Join-Path $CheckoutRoot 'windows/config/lazydocker/config.yml')) -replace '\r\n', "`n"
    $variant = [IO.File]::ReadAllText((Get-ThemeFile $CheckoutRoot $Name 'LazyDocker')) -replace '\r\n', "`n"
    # LazyDocker has no include mechanism, so the variant body goes between the markers.
    $body = ($variant -replace '\A(?:#[^\n]*\n|\n)*', '').TrimEnd("`n")
    $pattern = '(?m)^# >>> theme\n# <<< theme$'
    if ([regex]::Matches($base, $pattern).Count -ne 1) {
        throw 'windows/config/lazydocker/config.yml must hold exactly one empty theme marker block.'
    }
    $config = [regex]::Replace($base, $pattern, { "# >>> theme: $Name`n$body`n# <<< theme" })
    "$script:GeneratedHeader`n$config"
}

function Set-TerminalScheme {
    param([string] $Text, [string] $Scheme)

    $keys = [regex]::Matches($Text, '"colorScheme"\s*:\s*"[^"]*"')
    if ([regex]::Matches($Text, '"colorScheme"\s*:').Count -ne $keys.Count) {
        throw 'Windows Terminal settings.json sets colorScheme to a light/dark pair. Set it to one scheme name in profiles.defaults, then rerun set-theme.'
    }
    if ($keys.Count -gt 1) {
        throw 'Windows Terminal settings.json sets colorScheme more than once. Keep it only in profiles.defaults, then rerun set-theme.'
    }
    if ($keys.Count -eq 1) {
        return $Text.Remove($keys[0].Index, $keys[0].Length).Insert($keys[0].Index, "`"colorScheme`": `"$Scheme`"")
    }
    $defaults = [regex]::Matches($Text, '"defaults"\s*:\s*\{(\s*)(\}?)')
    if ($defaults.Count -ne 1) {
        throw 'Windows Terminal settings.json has no single profiles.defaults object to set colorScheme in.'
    }
    $comma = if ($defaults[0].Groups[2].Value) { '' } else { ',' }
    $Text.Insert($defaults[0].Groups[1].Index, " `"colorScheme`": `"$Scheme`"$comma")
}

function Assert-LazyDockerConfigOwned {
    param([string] $Path, [string] $CheckoutRoot)

    $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
    if (-not $item) { return }
    if ($item.LinkType) {
        # The earlier setup linked this file to the tracked base; that link is ours to replace.
        $tracked = Join-Path $CheckoutRoot 'windows\config\lazydocker\config.yml'
        if ([IO.Path]::GetFullPath(@($item.Target)[0]) -ieq [IO.Path]::GetFullPath($tracked)) { return }
        throw "$Path is a link that set-theme does not manage. Move it aside, then rerun set-theme."
    }
    $firstLine = @(Get-Content -LiteralPath $Path -TotalCount 1)
    if ($firstLine.Count -eq 0 -or $firstLine[0] -cne $script:GeneratedHeader) {
        throw "$Path was not generated by set-theme. Move it aside, then rerun set-theme."
    }
}

function Set-ActiveTheme {
    <# Apply a theme to every tool; with -Save, also record it as this machine's active theme. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [string] $CheckoutRoot,
        [Parameter(Mandatory)] [string] $Name,
        [switch] $Save
    )

    if ($Name -notmatch '^[a-z0-9-]+$') {
        throw "Not a theme name: '$Name'. Run set-theme -List."
    }
    $theme = Get-ThemeCatalog -CheckoutRoot $CheckoutRoot | Where-Object Name -EQ $Name
    if (-not $theme) {
        throw "Unknown theme '$Name'. Run set-theme -List."
    }
    if ($theme.Missing.Count -gt 0) {
        throw "Theme '$Name' has no file for: $($theme.Missing -join ', '). Nothing was changed."
    }

    # Build and check everything first, so a refusal changes nothing.
    $lazyDockerPath = Get-LazyDockerConfigPath
    Assert-LazyDockerConfigOwned -Path $lazyDockerPath -CheckoutRoot $CheckoutRoot
    $lazyDocker = Get-LazyDockerConfig -CheckoutRoot $CheckoutRoot -Name $Name

    $terminalPath = Get-TerminalSettingsPath
    $terminal = if (Test-Path -LiteralPath $terminalPath -PathType Leaf) {
        Set-TerminalScheme -Text ([IO.File]::ReadAllText($terminalPath)) -Scheme (Get-TerminalSchemeName $CheckoutRoot $Name)
    }

    $btopPath = Get-BtopConfigPath
    $btopLine = "color_theme = `"$Name`""
    $btop = if (Test-Path -LiteralPath $btopPath -PathType Leaf) {
        $text = [IO.File]::ReadAllText($btopPath)
        if ($text -match '(?m)^color_theme\s*=') { $text -replace '(?m)^color_theme\s*=[^\r\n]*', $btopLine }
        else { $text.TrimEnd("`r", "`n") + "`n$btopLine`n" }
    }
    elseif (Test-Path -LiteralPath (Split-Path -Parent $btopPath) -PathType Container) {
        # btop fills in its other settings and writes the full file on exit.
        "$btopLine`n"
    }

    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $lazyDockerPath) | Out-Null
    Remove-Item -LiteralPath $lazyDockerPath -Force -ErrorAction SilentlyContinue
    [IO.File]::WriteAllText($lazyDockerPath, $lazyDocker)

    if ($null -ne $terminal) { [IO.File]::WriteAllText($terminalPath, $terminal) }
    else { Write-Warning "Windows Terminal settings not found at $terminalPath; open Terminal once, then rerun set-theme." }

    if ($null -ne $btop) {
        if (Get-Process -Name btop -ErrorAction SilentlyContinue) {
            Write-Warning 'btop is running and rewrites its config on exit; close it, then rerun set-theme.'
        }
        [IO.File]::WriteAllText($btopPath, $btop)
    }
    else { Write-Warning "btop is not installed at $(Split-Path -Parent $btopPath); install it, then rerun set-theme." }

    if ($Save) {
        $statePath = Get-ThemeStatePath
        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $statePath) | Out-Null
        [IO.File]::WriteAllText($statePath, "$Name`n")
    }
}

function Test-ActiveTheme {
    <# Failures where an installed config does not use the active theme. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)] [string] $CheckoutRoot)

    $name = Get-ActiveTheme
    $theme = Get-ThemeCatalog -CheckoutRoot $CheckoutRoot | Where-Object Name -EQ $name
    if (-not $theme -or $theme.Missing.Count -gt 0) {
        return "Active theme '$name' is unknown or incomplete; run set-theme -List."
    }

    $lazyDockerPath = Get-LazyDockerConfigPath
    if (-not (Test-Path -LiteralPath $lazyDockerPath -PathType Leaf) -or
        [IO.File]::ReadAllText($lazyDockerPath) -cne (Get-LazyDockerConfig -CheckoutRoot $CheckoutRoot -Name $name)) {
        "LazyDocker config does not match active theme '$name'; run set-theme."
    }

    $btopPath = Get-BtopConfigPath
    if ((Test-Path -LiteralPath $btopPath -PathType Leaf) -and
        [IO.File]::ReadAllText($btopPath) -notmatch "(?m)^color_theme\s*=\s*`"$name`"\s*$") {
        "btop does not use active theme '$name'; close btop, then run set-theme."
    }

    $terminalPath = Get-TerminalSettingsPath
    $scheme = Get-TerminalSchemeName $CheckoutRoot $name
    if ((Test-Path -LiteralPath $terminalPath -PathType Leaf) -and
        [IO.File]::ReadAllText($terminalPath) -notmatch "`"colorScheme`"\s*:\s*`"$([regex]::Escape($scheme))`"") {
        "Windows Terminal does not use active theme '$name'; run set-theme."
    }
}

Export-ModuleMember -Function Get-ThemeCatalog, Get-DefaultTheme, Get-ActiveTheme, Set-ActiveTheme, Test-ActiveTheme
