font-family             = "IoskeleyMonoTerm Nerd Font Mono"
font-size               = 14.5
adjust-cell-height      = 2.5%

# font-family             = "JetBrainsMono Nerd Font Mono"
# font-size               = 14
# Ghostty draws box glyphs (─├└) at the exact cell centre, which leaves JetBrains Mono's
# ">" sitting low beside them (tmux tree "├─>"); nudge the text baseline up to meet the line.
# adjust-font-baseline    = 2

theme                   = "catppuccin-mocha"
# theme                   = "default-dark-modern"
# theme                   = "catppuccin-macchiato"
# theme                   = "dark-2026"

background-opacity      = 0.8
background-blur-radius  = 20
cursor-color            = cell-foreground
cursor-text             = cell-background
adjust-cursor-thickness = 2
macos-titlebar-style    = "hidden"
window-colorspace       = "display-p3"

# The hidden titlebar puts the first row against the rounded window edge; give the top extra room.
window-padding-x        = 8
window-padding-y        = 8,4
