#!/usr/bin/env python3
"""Apply this Mac's active theme to every themed tool; the choice is saved outside the checkout."""

from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import tempfile
import sys
from pathlib import Path


DEFAULT_THEME = "catppuccin-macchiato"
NAME = re.compile(r"[a-z0-9-]+")
# Each tool's theme file, relative to the platform folder and installed at the same path under $HOME.
THEME_FILES = {
    "starship": ".config/starship.{}.toml",
    "LazyGit": ".config/lazygit/themes/{}.yml",
    "tmux": ".tmux/themes/{}.conf",
    "Ghostty": ".config/ghostty/themes/{}",
    "LazyDocker": ".config/lazydocker/themes/{}.yml",
    "superfile": ".config/superfile/theme/{}.toml",
    "btop": ".config/btop/themes/{}.theme",
    # Each imports the theme's Neovim specs, including Snacks' embedded LazyGit colours.
    "Neovim": ".config/nvim/lua/macos_themes/{}.lua",
}
# Theme files that keep a historical name, by tool and theme.
FILE_NAMES = {"tmux": {"catppuccin-mocha": "catppuccin"}}
# The tools shell startup configures; a theme they lack falls back to the default.
SHELL_TOOLS = ("starship", "LazyGit")
LAZYGIT_BASE = ".config/lazygit/config.yml"
TMUX_BASE = ".tmux/base.conf"
GHOSTTY_BASE = ".config/ghostty/base"
LAZYDOCKER_BASE = ".config/lazydocker/base.yml"
SUPERFILE_BASE = ".config/superfile/base.toml"
# The tracked file that reads the generated selection, named in its header.
NVIM_BASE = ".config/nvim/lua/plugins/colorscheme.lua"
# LazyVim colorschemes that are not named after their theme.
NVIM_COLORSCHEMES = {"default-dark-modern": "vscode"}
# btop owns this file and rewrites it on exit; set-theme changes only its color_theme line.
BTOP_CONFIG = ".config/btop/btop.conf"
COLOR_THEME = re.compile(r"(?m)^color_theme\s*=[^\r\n]*")
# Folders the earlier setup linked whole into the checkout; set-theme replaces them with real ones.
OLD_DIRECTORY_LINKS = (".config/lazydocker", ".config/superfile")


class ThemeError(Exception):
    pass


def state_path(home: Path) -> Path:
    state_home = os.environ.get("XDG_STATE_HOME") or home / ".local/state"
    return Path(state_home) / "dotfiles/theme"


def theme_file(tool: str, name: str) -> str:
    """The tool's theme file for a theme, relative to the platform folder and to $HOME."""
    return THEME_FILES[tool].format(FILE_NAMES.get(tool, {}).get(name, name))


def catalog(root: Path) -> dict[str, list[str]]:
    """Every theme any tool has a file for, with the tools it is missing."""
    names = set()
    for tool, pattern in THEME_FILES.items():
        themes = {file: theme for theme, file in FILE_NAMES.get(tool, {}).items()}
        prefix, suffix = Path(pattern).name.split("{}")
        for path in (root / pattern).parent.glob(f"{prefix}*{suffix}"):
            name = path.name[len(prefix) : len(path.name) - len(suffix)]
            if NAME.fullmatch(name) and path.is_file():
                names.add(themes.get(name, name))
    return {
        name: [tool for tool in THEME_FILES if not (root / theme_file(tool, name)).is_file()]
        for name in sorted(names)
    }


def active_theme(home: Path) -> str:
    """The saved theme name, or the default theme when none is saved."""
    path = state_path(home)
    if not path.is_file():
        return DEFAULT_THEME
    try:
        name = path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeDecodeError) as error:
        raise ThemeError(f"The saved theme in {path} cannot be read ({error}). Run set-theme <name>.") from error
    if not NAME.fullmatch(name):
        raise ThemeError(f"The saved theme in {path} is not a theme name: '{name}'. Run set-theme <name>.")
    return name


def validate(root: Path, name: str) -> None:
    if not NAME.fullmatch(name):
        raise ThemeError(f"'{name}' is not a theme name. Run set-theme --list.")
    missing = catalog(root).get(name)
    if missing is None:
        raise ThemeError(f"Unknown theme '{name}'. Run set-theme --list.")
    if missing:
        raise ThemeError(f"Theme '{name}' has no file for: {', '.join(missing)}. Nothing was changed.")


def startup_theme(root: Path, home: Path) -> str:
    """The active theme for a new shell, which warns and uses the default rather than fail."""
    try:
        name = active_theme(home)
        validate(root, name)
        missing = [tool for tool in SHELL_TOOLS if not (home / theme_file(tool, name)).is_file()]
        if missing:
            raise ThemeError(f"Theme '{name}' is not installed for: {', '.join(missing)}; run check-links --create.")
    except ThemeError as error:
        print(f"warning: {error} Using the default theme {DEFAULT_THEME}.", file=sys.stderr)
        return DEFAULT_THEME
    return name


def shell_exports(home: Path, name: str) -> dict[str, str]:
    return {
        "STARSHIP_CONFIG": str(home / theme_file("starship", name)),
        "LG_CONFIG_FILE": f"{home / LAZYGIT_BASE},{home / theme_file('LazyGit', name)}",
    }


def header(base: str, comment: str = "#") -> str:
    return f"{comment} Generated by macos/scripts/set-theme from macos/{base}; edits are overwritten.\n"


def nvim_selection(name: str) -> str:
    """The Lua table the tracked colorscheme.lua reads: colorscheme, Catppuccin flavour and theme import together."""
    fields = {"colorscheme": NVIM_COLORSCHEMES.get(name, name)}
    if name.startswith("catppuccin-"):
        fields["flavour"] = name.removeprefix("catppuccin-")
    fields["import"] = f"macos_themes.{name}"
    body = ", ".join(f'{key} = "{value}"' for key, value in fields.items())
    return f"{header(NVIM_BASE, '--')}return {{ {body} }}\n"


def lazydocker_config(root: Path, name: str) -> str:
    """The base with the variant between its markers, minus the variant's leading comment and blank lines."""
    base = (root / LAZYDOCKER_BASE).read_text(encoding="utf-8")
    variant = (root / theme_file("LazyDocker", name)).read_text(encoding="utf-8")
    body = re.sub(r"\A(?:#[^\n]*\n|\n)*", "", variant).rstrip("\n")
    marker = re.compile(r"(?m)^# >>> theme\n# <<< theme$")
    if len(marker.findall(base)) != 1:
        raise ThemeError(f"macos/{LAZYDOCKER_BASE} must hold exactly one empty theme marker block.")
    # LazyDocker has no include mechanism, so the variant body goes between the markers.
    return header(LAZYDOCKER_BASE) + marker.sub(lambda _: f"# >>> theme: {name}\n{body}\n# <<< theme", base)


def generated(root: Path, name: str) -> dict[str, str]:
    """Each generated config's content, by target under $HOME; the old setup linked each target to the same path here."""
    return {
        ".tmux.conf": f"{header(TMUX_BASE)}set -g @theme {Path(theme_file('tmux', name)).stem}\nsource-file ~/{TMUX_BASE}\n",
        # Ghostty has no theme include, so the theme follows the base's other settings.
        ".config/ghostty/config": (
            f"{header(GHOSTTY_BASE)}{(root / GHOSTTY_BASE).read_text(encoding='utf-8')}theme = \"{name}\"\n"
        ),
        ".config/lazydocker/config.yml": lazydocker_config(root, name),
        ".config/nvim/lua/active_theme.lua": nvim_selection(name),
        # A TOML top-level key must come before any table, so the theme leads the base.
        ".config/superfile/config.toml": (
            f"{header(SUPERFILE_BASE)}theme = '{name}'\n{(root / SUPERFILE_BASE).read_text(encoding='utf-8')}"
        ),
    }


def old_link(root: Path, home: Path, target: str) -> bool:
    """Whether $HOME/target is the earlier setup's link to the same path in the checkout."""
    path = home / target
    return path.is_symlink() and Path(os.path.normpath(path.parent / os.readlink(path))) == root / target


def old_directory_links(root: Path, home: Path) -> list[Path]:
    return [home / target for target in OLD_DIRECTORY_LINKS if old_link(root, home, target)]


def assert_owned(root: Path, home: Path, target: str) -> None:
    """Refuse a write that is not set-theme's: only its own file, or an old repo link, is replaced."""
    path = home / target
    # The platform folder sits in the checkout, whose shared/ and other platforms must stay unwritten too.
    checkout = root.resolve().parent
    # An old folder link becomes an empty real folder, so only the folders above it matter.
    replaced = [link for link in old_directory_links(root, home) if path.is_relative_to(link)]
    parent = replaced[0].parent if replaced else path.parent
    if parent.resolve().is_relative_to(checkout):
        raise ThemeError(f"{parent} leads into the checkout. Move it aside, then rerun set-theme.")
    if replaced:
        return
    if path.is_symlink():
        # The earlier setup linked this file into the checkout; that link is ours to replace.
        if not old_link(root, home, target):
            raise ThemeError(f"{path} is a link that set-theme does not manage. Move it aside, then rerun set-theme.")
    elif path.exists():
        try:
            with path.open(encoding="utf-8") as file:
                first = file.readline()
        except (OSError, UnicodeDecodeError):
            first = ""
        if not re.match(r"(#|--) Generated by macos/scripts/set-theme", first):
            raise ThemeError(f"{path} was not generated by set-theme. Move it aside, then rerun set-theme.")


def btop_config(root: Path, home: Path, name: str) -> str | None:
    """btop's config with only color_theme set to the theme, or None when btop has no config folder."""
    path = home / BTOP_CONFIG
    line = f'color_theme = "{name}"'
    if path.parent.resolve().is_relative_to(root.resolve().parent):
        raise ThemeError(f"{path.parent} leads into the checkout. Move it aside, then rerun set-theme.")
    if path.is_symlink():
        if not old_link(root, home, BTOP_CONFIG):
            raise ThemeError(f"{path} is a link that set-theme does not manage. Move it aside, then rerun set-theme.")
        if not path.exists():
            raise ThemeError(f"{path} links to a file that is gone. Restore your btop settings there, then rerun set-theme.")
    if path.is_file():
        try:
            # Read through an old link too, so the runtime copy keeps the tracked settings and line endings.
            text = path.read_bytes().decode("utf-8")
        except (OSError, UnicodeDecodeError) as error:
            raise ThemeError(f"{path} cannot be read ({error}). Move it aside, then rerun set-theme.") from error
        if COLOR_THEME.search(text):
            return COLOR_THEME.sub(lambda _: line, text)
        return text.rstrip("\r\n") + f"\n{line}\n"
    if path.parent.is_dir():
        # btop fills in its other settings and writes the full file on exit.
        return f"{line}\n"
    return None


def btop_theme_copies(root: Path, home: Path) -> list[Path]:
    """Real btop theme files where the checkout's links belong; each must match its checkout bytes."""
    copies = []
    for name in catalog(root):
        installed, tracked = home / theme_file("btop", name), root / theme_file("btop", name)
        if installed.is_symlink() or not installed.is_file() or not tracked.is_file():
            continue
        if installed.read_bytes() != tracked.read_bytes():
            raise ThemeError(f"{installed} differs from the checkout's {tracked}. Move it aside, then rerun set-theme.")
        copies.append(installed)
    return copies


def link(path: Path, source: Path) -> None:
    """Replace the file with a relative link to source, as check-links makes it."""
    temporary = path.with_name(f".{path.name}.link")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(os.path.relpath(source, path.parent))
    os.replace(temporary, path)


def write(path: Path, content: str) -> None:
    """Replace the file, or an old link, without following it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    # A fresh temporary file, so nothing planted beside the target is followed.
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(descriptor, "w", encoding="utf-8") as file:
        file.write(content)
    os.replace(temporary, path)


def check(root: Path, home: Path) -> tuple[str, list[str]]:
    """The active theme, and each way the installed tools do not use it."""
    name = active_theme(home)
    validate(root, name)
    failures = []
    for tool in THEME_FILES:
        installed = home / theme_file(tool, name)
        if not installed.is_file():
            failures.append(f"{tool} theme file {installed} is missing; run check-links --create.")
        elif installed.resolve() != (root / theme_file(tool, name)).resolve():
            failures.append(f"{tool} theme file {installed} is not the checkout's file; run check-links.")
    for target, content in generated(root, name).items():
        installed = home / target
        if installed.is_symlink() or not installed.is_file() or installed.read_bytes() != content.encode():
            failures.append(f"{installed} does not match active theme '{name}'; run set-theme.")
    btop = home / BTOP_CONFIG
    if btop.is_symlink():
        failures.append(f"{btop} is still a link, not btop's own file; run set-theme.")
    elif btop.is_file() and not re.search(rf'(?m)^color_theme\s*=\s*"{re.escape(name)}"\s*$', btop.read_bytes().decode("utf-8", "replace")):
        failures.append(f"{btop} does not use active theme '{name}'; close btop, then run set-theme.")
    failures += [
        f"{key} does not use active theme '{name}'; open a new shell."
        for key, value in shell_exports(home, name).items()
        if os.environ.get(key) != value
    ]
    return name, failures


def apply(root: Path, home: Path, name: str, save: bool) -> None:
    validate(root, name)
    # Check and build everything first, so a refusal changes nothing.
    configs = generated(root, name)
    for target in configs:
        assert_owned(root, home, target)
    btop = btop_config(root, home, name)
    copies = btop_theme_copies(root, home)
    for directory in old_directory_links(root, home):
        directory.unlink()
    for copy in copies:
        # Same bytes, so the copy is replaced by the link check-links expects there.
        link(copy, root / copy.relative_to(home))
    for target, content in configs.items():
        write(home / target, content)
    if btop is None:
        print(f"warning: btop has no config folder {(home / BTOP_CONFIG).parent}; install btop, then rerun set-theme.", file=sys.stderr)
    else:
        if subprocess.run(["pgrep", "-x", "btop"], capture_output=True).returncode == 0:
            print("warning: btop is running and rewrites its config on exit; close it, then rerun set-theme.", file=sys.stderr)
        write(home / BTOP_CONFIG, btop)
    if save:
        path = state_path(home)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(f"{name}\n", encoding="utf-8")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", help="theme to apply and save; omit to reapply the saved or default theme")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--list", action="store_true", help="list complete themes and mark the active one")
    modes.add_argument("--check", action="store_true", help="report installed configs that do not use the active theme")
    modes.add_argument("--env", action="store_true", help="print the shell exports for the active theme (read by .zshrc)")
    parser.add_argument("--home", type=Path, default=Path.home(), help=argparse.SUPPRESS)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent, help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    home = args.home.absolute()
    root = args.root.absolute()
    try:
        if args.list:
            active = active_theme(home)
            for name, missing in catalog(root).items():
                if not missing:
                    print(f"{'*' if name == active else ' '} {name}")
            return 0
        if args.check:
            name, failures = check(root, home)
            for failure in failures:
                print(failure)
            print(f"theme {name}: {len(failures)} problems")
            return 1 if failures else 0
        if args.env:
            for key, value in shell_exports(home, startup_theme(root, home)).items():
                print(f"export {key}={shlex.quote(value)}")
            return 0
        # Read the saved theme only without a name, so a name recovers from corrupt state.
        name = args.name or active_theme(home)
        apply(root, home, name, save=bool(args.name))
    except ThemeError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    print(f"Applied theme {name}. Open a new shell, and restart running tools, to see it.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
