# Dark 2026 for btop
#
# Copy into ~/.config/btop/themes/, then set
#   color_theme = "dark-2026"
# in ~/.config/btop/btop.conf (or pick it from btop's options menu).
#
# Each value names the VS Code key it came from, as in palette.lua. Graph
# gradients run through the terminal's bright ANSI slots, which are VS Code's
# built-in defaults (palette.lua M.ansi), ending on a chart accent.

# Main background
theme[main_bg]="#121314" # editor.background

# Main text color
theme[main_fg]="#bfbfbf" # foreground

# Title color for boxes
theme[title]="#bfbfbf" # foreground

# Highlight color for keyboard shortcuts
theme[hi_fg]="#48a0c7" # textLink.foreground

# Background color of selected item in processes box
theme[selected_bg]="#276782" # editor.selectionBackground, opaque base

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff" # button.foreground

# Color of inactive/disabled text
theme[inactive_fg]="#555555" # disabledForeground

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#8c8c8c" # descriptionForeground

# Background color of the percentage meters
theme[meter_bg]="#2a2b2c" # widget.border

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#57a3f8" # charts.blue

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#ad80d7"  # charts.purple
theme[mem_box]="#73c991"  # gitDecoration.addedResourceForeground
theme[net_box]="#cd861a"  # charts.orange
theme[proc_box]="#57a3f8" # charts.blue

# Box divider line and small boxes line color
theme[div_line]="#2a2b2c" # panel.border

# Temperature graph color (bright green -> bright yellow -> bright red)
theme[temp_start]="#23d18b"
theme[temp_mid]="#f5f543"
theme[temp_end]="#f14c4c"

# CPU graph colors (bright cyan -> bright blue -> charts.purple)
theme[cpu_start]="#29b8db"
theme[cpu_mid]="#3b8eea"
theme[cpu_end]="#ad80d7"

# Mem/Disk free meter (charts.purple -> bright blue -> charts.blue)
theme[free_start]="#ad80d7"
theme[free_mid]="#3b8eea"
theme[free_end]="#57a3f8"

# Mem/Disk cached meter (bright cyan -> bright blue -> charts.blue)
theme[cached_start]="#29b8db"
theme[cached_mid]="#3b8eea"
theme[cached_end]="#57a3f8"

# Mem/Disk available meter (charts.orange -> modified -> bright red)
theme[available_start]="#cd861a"
theme[available_mid]="#e5ba7d"
theme[available_end]="#f14c4c"

# Mem/Disk used meter (added -> bright green -> bright cyan)
theme[used_start]="#73c991"
theme[used_mid]="#23d18b"
theme[used_end]="#29b8db"

# Download graph colors (charts.orange -> modified -> bright red)
theme[download_start]="#cd861a"
theme[download_mid]="#e5ba7d"
theme[download_end]="#f14c4c"

# Upload graph colors (added -> bright green -> bright cyan)
theme[upload_start]="#73c991"
theme[upload_mid]="#23d18b"
theme[upload_end]="#29b8db"

# Process box color gradient for threads, mem and cpu usage (bright cyan -> bright blue -> charts.purple)
theme[process_start]="#29b8db"
theme[process_mid]="#3b8eea"
theme[process_end]="#ad80d7"
