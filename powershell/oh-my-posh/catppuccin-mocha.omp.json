{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }} - pwsh",
  "palette": {
    "base": "#1e1e2e",
    "text": "#cdd6f4",
    "surface1": "#45475a",
    "surface2": "#585b70",
    "blue": "#89b4fa",
    "teal": "#94e2d5",
    "green": "#a6e3a1",
    "peach": "#fab387",
    "red": "#f38ba8",
    "yellow": "#f9e2af"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "background": "p:peach",
          "foreground": "p:base",
          "template": " {{ .Icon }}",
          "options": {
            "windows": "󰍲",
            "macos": "󰀵",
            "linux": "󰌽"
          }
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:peach",
          "foreground": "p:base",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:yellow",
          "foreground": "p:base",
          "template": " {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "…",
            "home_icon": "~",
            "mapped_locations": {
              "~/Documents": "󰂙 Documents",
              "~/Downloads": " Downloads",
              "~/Music": "󰍚 Music",
              "~/Pictures": " Pictures",
              "~/Developer": "󱂋 Developer"
            }
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:teal",
          "foreground": "p:base",
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "options": {
            "branch_icon": " ",
            "branch_ahead_icon": "⇡",
            "branch_behind_icon": "⇣",
            "branch_identical_icon": "≡"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": "  {{ .Full }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": "  {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": "  {{ .Full }} "
        },
        {
          "type": "java",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": "  {{ .Full }} "
        },
        {
          "type": "php",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": "  {{ .Full }} "
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": "  {{ .Full }} "
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:surface1",
          "foreground": "p:text",
          "template": "  {{ .CurrentDate | date \"15:04\" }} ",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hidden",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:surface2",
          "template": "took {{ .FormattedMs }}",
          "options": {
            "threshold": 2000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "󰄛 ❯ "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
    "template": "󰄛 ❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:surface2",
    "template": "∙∙ "
  }
}
