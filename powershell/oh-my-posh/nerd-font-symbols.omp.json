{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }} - pwsh",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "blue",
          "template": "{{ .Path }} ",
          "options": {
            "style": "folder",
            "folder_icon": "…",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "magenta",
          "template": "on {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <red>{{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <green>{{ .Staging.String }}</>{{ end }} ",
          "options": {
            "branch_icon": " ",
            "branch_ahead_icon": "⇡",
            "branch_behind_icon": "⇣",
            "branch_identical_icon": "≡",
            "fetch_status": true
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "green",
          "template": "via  {{ .Full }} "
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "green",
          "template": "via  {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "green",
          "template": "via 󱘗 {{ .Full }} "
        },
        {
          "type": "java",
          "style": "plain",
          "foreground": "green",
          "template": "via  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "yellow",
          "template": "via  {{ .Full }} "
        },
        {
          "type": "php",
          "style": "plain",
          "foreground": "blue",
          "template": "via  {{ .Full }} "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "magenta",
          "template": "via  {{ .Full }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "yellow",
          "template": "took {{ .FormattedMs }} ",
          "options": {
            "threshold": 2000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "green",
          "foreground_templates": ["{{ if gt .Code 0 }}red{{ end }}"],
          "template": "❯ "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "green",
    "foreground_templates": ["{{ if gt .Code 0 }}red{{ end }}"],
    "template": "❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "darkGray",
    "template": "∙ "
  }
}
